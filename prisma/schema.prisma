  @@index([tenantId, status])
  @@index([planningRunId])
}

model CapacityResource {
  id                String   @id @default(uuid())
  tenantId          String
  resourceType      String // MACHINE, TEAM, WORKFLOW, WAREHOUSE
  resourceId        String
  capacityUnit      String // HOURS, PIECES, GB
  availableCapacity Decimal
  plannedCapacity   Decimal  @default(0)
  reservedCapacity  Decimal  @default(0)
  effectiveFrom     DateTime
  effectiveTo       DateTime
  calendarId        String?
  status            String   @default("ACTIVE")
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, resourceType, resourceId])
}

// ==========================================
// 20. Inventory Control & Traceability
// ==========================================

model InventoryBalance {
  id          String  @id @default(uuid())
  tenantId    String
  itemId      String // Refers to Product/Material
  warehouseId String
  locationId  String?
  lotId       String?
  unit        String

  quantityOnHand    Decimal @default(0)
  quantityReserved  Decimal @default(0)
  quantityAvailable Decimal @default(0) // Computed: OnHand - Reserved

  status        String    @default("AVAILABLE")
  lastCountedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location  Location? @relation(fields: [locationId], references: [id])
  lot       LotBatch? @relation(fields: [lotId], references: [id])

  @@unique([tenantId, itemId, warehouseId, locationId, lotId])
}

model StockMovement {
  id             String  @id @default(uuid())
  tenantId       String
  movementNumber String  @unique
  movementType   String // RECEIPT, ISSUE, TRANSFER, ADJUSTMENT
  itemId         String
  warehouseId    String
  fromLocationId String?
  toLocationId   String?
  lotId          String?

  quantity Decimal
  unit     String

  referenceType String? // PO, SO, CYCLE_COUNT
  referenceId   String?
  reason        String?
  performedBy   String

  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([tenantId, itemId])
  @@index([tenantId, movementType])
}

model StockReservation {
  id            String @id @default(uuid())
  tenantId      String
  itemId        String
  warehouseId   String
  referenceType String // SALES_ORDER, WORK_ORDER
  referenceId   String

  requestedQuantity Decimal
  reservedQuantity  Decimal @default(0)
  status            String  @default("PENDING") // PENDING, ACTIVE, RELEASED

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, itemId])
  @@index([tenantId, status])
}

model LotBatch {
  id              String    @id @default(uuid())
  tenantId        String
  itemId          String
  lotNumber       String
  manufactureDate DateTime?
  expiryDate      DateTime?
  supplierId      String?
  status          String    @default("AVAILABLE") // AVAILABLE, QUARANTINED, EXPIRED, RECALLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory InventoryBalance[]

  @@unique([tenantId, itemId, lotNumber])
}

model CycleCount {
  id          String  @id @default(uuid())
  tenantId    String
  warehouseId String
  locationId  String?
  itemId      String?

  expectedQuantity Decimal?
  countedQuantity  Decimal?
  variance         Decimal?

  status String @default("PLANNED") // PLANNED, IN_PROGRESS, COUNTED, APPROVED, REJECTED, POSTED

  countedBy  String?
  approvedBy String?
  countedAt  DateTime?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, warehouseId, status])
}

// ==========================================
// 21. Production & Manufacturing Operations
// ==========================================

model BillOfMaterials {
  id            String    @id @default(uuid())
  tenantId      String
  productId     String // ID of the finished product
  version       String    @default("1.0")
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE, OBSOLETE
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  components       BomComponent[]
  productionOrders ProductionOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, productId, version])
}

model BomComponent {
  id                String  @id @default(uuid())
  tenantId          String
  billOfMaterialsId String
  materialId        String // ID of the component material
  quantity          Decimal
  unit              String
  wastagePercentage Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billOfMaterials BillOfMaterials @relation(fields: [billOfMaterialsId], references: [id], onDelete: Cascade)

  @@index([tenantId, materialId])
}

model WorkCenter {
  id           String  @id @default(uuid())
  tenantId     String
  code         String
  name         String
  capacityUnit String // HOURS, PIECES
  capacity     Decimal @default(0)
  status       String  @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE

  productionOrders ProductionOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model ProductionOrder {
  id          String  @id @default(uuid())
  tenantId    String
  orderNumber String  @unique
  productId   String
  quantity    Decimal
  unit        String
  status      String  @default("DRAFT") // DRAFT, PLANNED, RELEASED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  priority    String  @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  salesOrderId String?
  warehouseId  String?

  producedQuantity Decimal @default(0)
  rejectedQuantity Decimal @default(0)

  notes String?

  bomId        String?
  workCenterId String?

  bom        BillOfMaterials? @relation(fields: [bomId], references: [id])
  workCenter WorkCenter?      @relation(fields: [workCenterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, productId])
}

// ==========================================
