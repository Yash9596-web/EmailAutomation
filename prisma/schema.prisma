generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// STAGE 2: COMPREHENSIVE DATA LAYER
// ============================================================================
// Inspection findings applied:
//   - Added tenantId to Workflow, Agent, Integration (tenant ownership)
//   - Added Membership status field
//   - Added Role.tenantId + Role.isSystem for system vs tenant roles
//   - Added WorkflowTask (Section 34)
//   - Added EventProcessingRecord for idempotent event consumption (Section 24)
//   - Added IdempotencyRecord (Section 50)
//   - Added SystemSetting, TenantSetting, UserPreference (Sections 36-39)
//   - Added AIProviderModel registry (Sections 41-44)
//   - Added AgentVersion (Section 46)
//   - Added Tool registry (Section 47)
//   - Added Document/DocumentVersion (Section 63)
//   - Added version fields for optimistic concurrency (Section 52)
//   - Improved composite indexes (Section 56)
//   - Added aggregate_type to DomainEvent (Section 23)
//   - Added priority/idempotencyKey/jobType to JobRecord (Sections 27-29)

// ==========================================
// 1. Tenancy & Identity
// ==========================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("Active") // Active | Suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  auditLogs       AuditLog[]
  events          DomainEvent[]
  jobs            JobRecord[]
  workflows       Workflow[]
  agents          Agent[]
  integrations    Integration[]
  roles           Role[]
  settings        TenantSetting[]
  documents       Document[]
  IngestionRecord IngestionRecord[]

  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String? // Nullable for future SSO support
  status       String   @default("ACTIVE") // ACTIVE | PENDING | SUSPENDED | DISABLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  preferences    UserPreference[]
  sessions       Session[]
  securityTokens SecurityToken[]
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  roleId    String?
  status    String   @default("Active") // Active | Suspended | Invited
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // Hashed or opaque secure token
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  metadata  Json? // IP, User-Agent, Device info
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked, expiresAt])
  @@index([token])
}

model SecurityToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique // Hashed secure token for resets/invites
  type      String // PASSWORD_RESET | EMAIL_VERIFICATION | INVITATION
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, type])
}

// ==========================================
// 2. Authorization (RBAC)
// ==========================================

model Role {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String
  description String?
  isSystem    Boolean  @default(false) // true = platform-wide, false = tenant-scoped
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions Permission[]
  memberships Membership[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  action    String // read | write | delete | execute | *
  resource  String // workflows | users | agents | integrations | *
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action, resource])
}

// ==========================================
// 3. Audit (Append-only, Immutable)
// ==========================================

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  actorType    String // USER | SYSTEM | AGENT
  actorId      String
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  requestId    String?
  timestamp    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, timestamp])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
}

// ==========================================
// 4. Domain Events
// ==========================================

model DomainEvent {
  eventId       String   @id @default(uuid())
  eventType     String
  aggregateType String   @default("unknown")
  aggregateId   String
  tenantId      String?
  version       Int      @default(1)
  payload       Json
  metadata      Json?
  occurredAt    DateTime @default(now())

  tenant     Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  processing EventProcessingRecord[]

  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([tenantId, occurredAt])
}

// Event idempotency: tracks which consumers have processed which events
model EventProcessingRecord {
  id          String   @id @default(uuid())
  eventId     String
  consumer    String
  status      String   @default("Processed") // Processed | Failed
  processedAt DateTime @default(now())

  event DomainEvent @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@unique([eventId, consumer])
}

// ==========================================
// 5. Background Jobs
// ==========================================

model JobRecord {
  id             String    @id @default(uuid())
  queue          String
  jobType        String    @default("default")
  tenantId       String?
  state          String    @default("Queued") // Queued | Running | Succeeded | Failed | Retrying | Cancelled
  priority       Int       @default(0)
  payload        Json
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  idempotencyKey String?
  errorDetail    String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([queue, state])
  @@index([tenantId])
  @@index([jobType])
  @@index([state, priority])
}

// ==========================================
// 6. Idempotency
// ==========================================

model IdempotencyRecord {
  id          String    @id @default(uuid())
  key         String
  tenantId    String?
  operation   String
  requestHash String?
  status      String    @default("Completed") // Completed | InProgress | Failed
  responseRef String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([tenantId, key])
  @@index([expiresAt])
}

// ==========================================
// 7. Workflows
// ==========================================

model Workflow {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  status      String   @default("Draft") // Draft | Published | Paused | Archived
  version     Int      @default(1) // Optimistic concurrency
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions WorkflowVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String
  version    Int
  status     String   @default("Draft") // Draft | Published | Deprecated
  definition Json // Immutable task graph/DAG once published
  createdAt  DateTime @default(now())

  workflow Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs     WorkflowRun[]

  @@unique([workflowId, version])
}

model WorkflowRun {
  id                String    @id @default(uuid())
  workflowVersionId String
  tenantId          String
  status            String    @default("Pending") // Pending | Running | Waiting | Succeeded | Failed | Cancelled
  error             String?
  metadata          Json?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  version WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  tasks   WorkflowTask[]

  @@index([tenantId, status])
  @@index([workflowVersionId])
}

model WorkflowTask {
  id            String    @id @default(uuid())
  workflowRunId String
  taskType      String
  status        String    @default("Pending") // Pending | Running | Succeeded | Failed | Skipped
  sequence      Int       @default(0)
  inputRef      String? // Reference to input (object storage key or inline JSON ref)
  outputRef     String? // Reference to output
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  run WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId, sequence])
  @@index([status])
}

// ==========================================
// 8. AI Provider Registry
// ==========================================

model AIProviderModel {
  id             String   @id @default(uuid())
  provider       String // openai | anthropic | google | azure | custom
  model          String // gpt-4o | claude-3.5-sonnet | etc.
  displayName    String?
  capability     String   @default("text") // text | embedding | vision | structured
  status         String   @default("Active") // Active | Deprecated | Disabled
  configMetadata Json? // Max tokens, pricing info, etc. (NOT secrets)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, model])
  @@index([capability])
  @@index([status])
}

// AI Usage Tracking
model AIUsageRecord {
  id           String   @id @default(uuid())
  tenantId     String?
  requestId    String?
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  status       String   @default("Success") // Success | Error
  costEstimate Float?
  timestamp    DateTime @default(now())

  @@index([tenantId, timestamp])
  @@index([provider, model])
}

// ==========================================
// 9. Agents
// ==========================================

model Agent {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  status    String   @default("Active") // Active | Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capabilities AgentCapability[]
  policy       AgentPolicy?
  versions     AgentVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model AgentVersion {
  id        String   @id @default(uuid())
  agentId   String
  version   Int
  config    Json // Frozen configuration snapshot
  status    String   @default("Draft") // Draft | Active | Deprecated
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
}

model AgentCapability {
  id          String @id @default(uuid())
  agentId     String
  name        String
  description String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
}

model AgentPolicy {
  id                    String   @id @default(uuid())
  agentId               String   @unique
  maxBudget             Float?
  allowedTools          String[]
  requiresHumanApproval Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

// ==========================================
// 10. Tool Registry
// ==========================================

model Tool {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  version     String   @default("1.0.0")
  schema      Json? // Input/output schema definition
  status      String   @default("Active") // Active | Deprecated | Disabled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 11. Integrations
// ==========================================

model Integration {
  id           String   @id @default(uuid())
  tenantId     String
  provider     String   @default("custom") // E.g., 'gmail', 'outlook', 'rest', 'erp_sap'
  name         String
  type         String // CRM | ERP | EMAIL | MESSAGING | CUSTOM
  status       String   @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONNECTING | CONNECTED | SYNCING | DEGRADED | AUTHENTICATION_FAILED | RATE_LIMITED | DISCONNECTED | DISABLED | ERROR
  enabled      Boolean  @default(true)
  capabilities String[] // e.g. ['EMAIL_READ', 'INVOICE_CREATE']
  config       Json? // Non-sensitive config (NOT secrets)

  lastConnectedAt DateTime?
  lastSyncAt      DateTime?
  lastErrorAt     DateTime?
  errorState      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials             IntegrationCredential[]
  externalIds             ExternalIdentifier[]
  events                  IntegrationEvent[]
  webhooks                IntegrationWebhook[]
  logs                    IntegrationLog[]
  syncJobs                IntegrationSyncJob[]
  IntegrationFieldMapping IntegrationFieldMapping[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@index([tenantId, provider])
  @@index([status])
}

model IntegrationCredential {
  id             String    @id @default(uuid())
  integrationId  String
  credentialType String    @default("token") // token | oauth | api_key | certificate | basic
  encryptedToken String // Encrypted at rest, NEVER plaintext
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model IntegrationEvent {
  id             String   @id @default(uuid())
  tenantId       String
  integrationId  String
  provider       String
  eventType      String
  source         String
  payloadRef     String?
  correlationId  String?
  idempotencyKey String?
  timestamp      DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, integrationId, idempotencyKey])
  @@index([tenantId, eventType])
}

model IntegrationWebhook {
  id            String   @id @default(uuid())
  tenantId      String
  integrationId String
  direction     String   @default("INBOUND") // INBOUND | OUTBOUND
  endpoint      String? // For OUTBOUND
  events        String[] // Subscribed events
  signingSecret String? // Encrypted secret
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration                  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  deliveries  IntegrationWebhookDelivery[]

  @@index([tenantId, direction])
}

model IntegrationWebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  tenantId     String
  status       String    @default("PENDING") // PENDING | SUCCESS | FAILED | RETRYING
  payload      Json?
  responseCode Int?
  errorMessage String?
  attemptCount Int       @default(0)
  nextRetryAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  webhook IntegrationWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
}

model IntegrationSyncJob {
  id             String    @id @default(uuid())
  tenantId       String
  integrationId  String
  syncType       String    @default("INCREMENTAL") // FULL | INCREMENTAL
  status         String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  itemsProcessed Int       @default(0)
  itemsCreated   Int       @default(0)
  itemsUpdated   Int       @default(0)
  itemsSkipped   Int       @default(0)
  itemsFailed    Int       @default(0)
  cursor         String?
  errorDetail    String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  integration             Integration               @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  IntegrationSyncConflict IntegrationSyncConflict[]

  @@index([integrationId, status])
}

model IntegrationLog {
  id            String   @id @default(uuid())
  tenantId      String
  integrationId String
  level         String   @default("INFO") // INFO | WARN | ERROR
  action        String
  message       String
  correlationId String?
  metadata      Json?
  timestamp     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, timestamp])
  @@index([tenantId, level])
}

// External system ID mapping (Section 49)
model ExternalIdentifier {
  id            String   @id @default(uuid())
  integrationId String
  internalType  String // The internal entity type (e.g., 'User', 'Workflow')
  internalId    String // The internal entity ID
  externalId    String // The external system's ID
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, internalType, internalId])
  @@unique([integrationId, externalId])
  @@index([internalType, internalId])
}

// ==========================================
// 12. Configuration
// ==========================================

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ==========================================
// 13. Data Ingestion & Document Intelligence
// ==========================================

model IngestionRecord {
  id                  String   @id @default(uuid())
  tenantId            String
  sourceType          String // EMAIL | API | UPLOAD | ERP | SFTP
  sourceIntegrationId String? // Optional link to the Integration that ingested this
  sourceReference     String? // Message ID, API payload ID, etc
  contentType         String? // e.g. 'application/json', 'multipart/form-data'
  fileReference       String? // Original payload/archive reference
  status              String   @default("RECEIVED") // RECEIVED | QUEUED | PROCESSING | COMPLETED | PARTIALLY_COMPLETED | FAILED
  processingVersion   Int      @default(1)
  correlationId       String?
  idempotencyKey      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([sourceType])
}

// ==========================================
// 13a. Document Foundation
// ==========================================

model Document {
  id                String   @id @default(uuid())
  tenantId          String
  ingestionId       String?
  title             String
  originalFilename  String?
  mimeType          String?
  fileSize          Int?
  storageRef        String? // Object storage key
  status            String   @default("RECEIVED") // RECEIVED | QUEUED | VALIDATING | PROCESSING | EXTRACTING | VALIDATING_DATA | AWAITING_REVIEW | COMPLETED | FAILED | REJECTED | CANCELLED
  source            String? // EMAIL | UPLOAD | API
  documentType      String? // INVOICE | PURCHASE_ORDER | QUOTATION | PAYMENT_SLIP | RECEIPT | DELIVERY_NOTE | SHIPPING_DOCUMENT | CONTRACT | UNKNOWN
  contentHash       String?
  extractedData     Json?
  validationResults Json?
  confidence        Float?
  processingError   String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingestion   IngestionRecord?        @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
  versions    DocumentVersion[]
  reviewTasks ReviewTask[]
  corrections HumanCorrectionRecord[]

  @@index([tenantId, status])
  @@index([tenantId, contentHash])
  @@index([documentType])
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  storageRef String // Object storage key for this version's content
  metadata   Json?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model ReviewTask {
  id                    String    @id @default(uuid())
  tenantId              String
  documentId            String
  status                String    @default("PENDING") // PENDING | COMPLETED | REJECTED
  assignedTo            String?
  fieldsRequiringReview Json?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([documentId])
}

model HumanCorrectionRecord {
  id               String   @id @default(uuid())
  tenantId         String
  documentId       String
  reviewerId       String
  fieldPath        String
  originalValue    Json?
  correctedValue   Json?
  extractorVersion String?
  createdAt        DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([tenantId, fieldPath])
}

model OAuthSession {
  id          String   @id @default(uuid())
  state       String   @unique
  tenantId    String
  provider    String
  userId      String
  redirectUri String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([state])
  @@index([tenantId])
}

// ==========================================
// 14. Business Entities & Transactions
// ==========================================

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  taxId     String?
  status    String   @default("ACTIVE")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices          Invoice[]
  Contact           Contact[]
  PurchaseOrder     PurchaseOrder[]
  SupplierQuotation SupplierQuotation[]

  @@index([tenantId, status])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  taxId     String?
  status    String   @default("ACTIVE")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices   Invoice[]
  Contact    Contact[]
  Quotation  Quotation[]
  SalesOrder SalesOrder[]

  @@index([tenantId, status])
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  sku       String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, sku])
}

model Invoice {
  id             String    @id @default(uuid())
  tenantId       String
  invoiceNumber  String
  supplierId     String?
  customerId     String?
  documentId     String? // Reference to source Document
  date           DateTime?
  dueDate        DateTime?
  currency       String    @default("USD")
  subtotal       Decimal   @default(0)
  taxAmount      Decimal   @default(0)
  discountAmount Decimal   @default(0)
  totalAmount    Decimal   @default(0)
  status         String    @default("DRAFT") // DRAFT | RECEIVED | VALIDATED | PENDING_APPROVAL | APPROVED | POSTED | PAID | CANCELLED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  customer          Customer?           @relation(fields: [customerId], references: [id])
  lines             InvoiceLine[]
  PaymentAllocation PaymentAllocation[]

  @@unique([tenantId, supplierId, invoiceNumber])
  @@index([tenantId, status])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1)
  unitPrice   Decimal @default(0)
  totalAmount Decimal @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id           String    @id @default(uuid())
  tenantId     String
  resourceType String // e.g. "Invoice"
  resourceId   String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy  String
  assignedTo   String?
  decision     String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

