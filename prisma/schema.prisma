// ==========================================
// 16. Enterprise Exception Management
// ==========================================

model ExceptionCase {
  id              String @id @default(uuid())
  tenantId        String
  exceptionNumber String // Auto-incremented or formatted string like EXC-1024
  category        String // DOCUMENT, FINANCIAL, PROCUREMENT, WORKFLOW, INTEGRATION
  type            String // e.g. 'invoice_mismatch', 'workflow_failure'
  status          String @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, WAITING, RESOLVED, CLOSED, REOPENED
  priority        String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  severity        String @default("MODERATE") // MINOR, MODERATE, MAJOR, SEVERE

  title       String
  description String?

  // Linkages
  sourceType         String? // WORKFLOW, DOCUMENT, INTEGRATION, TRANSACTION
  sourceId           String?
  sourceReference    String?
  workflowRunId      String?
  documentId         String?
  businessRecordType String?
  businessRecordId   String?

  // Assignment & SLA
  assignedUserId String?
  assignedTeamId String?

  dueAt          DateTime?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?

  // Resolution
  resolutionCode    String?
  resolutionSummary String?
  rootCause         String?

  // AI
  aiAnalysis        Json?
  recommendedAction Json?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments ExceptionComment[]
  history  ExceptionHistory[]

  @@unique([tenantId, exceptionNumber])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, assignedUserId])
  @@index([dueAt])
}

model ExceptionComment {
  id              String   @id @default(uuid())
  exceptionCaseId String
  tenantId        String
  userId          String
  content         String
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exceptionCase ExceptionCase @relation(fields: [exceptionCaseId], references: [id], onDelete: Cascade)

  @@index([exceptionCaseId])
}

model ExceptionHistory {
  id              String   @id @default(uuid())
  exceptionCaseId String
  tenantId        String
  actorType       String // USER, SYSTEM, AI
  actorId         String
  action          String
  changes         Json?
  createdAt       DateTime @default(now())

  exceptionCase ExceptionCase @relation(fields: [exceptionCaseId], references: [id], onDelete: Cascade)

  @@index([exceptionCaseId])
  @@index([tenantId, action])
}

// ==========================================
// 17. AI Operations & Copilot
// ==========================================

model Conversation {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  title         String?
  status        String   @default("ACTIVE") // ACTIVE | ARCHIVED
  contextType   String? // Global, Document, Exception, Supplier
  contextId     String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  messages Message[]

  @@index([tenantId, userId])
  @@index([tenantId, contextType, contextId])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  tenantId       String
  role           String // USER, ASSISTANT, SYSTEM, TOOL
  content        String
  structuredData Json? // Findings, actions, confidence, recommendations
  citations      Json? // List of references/evidence
  toolCalls      Json?
  confidence     Float?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==========================================
// 18. Predictive Operations & Risk Intelligence
// ==========================================

model Prediction {
  id             String   @id @default(uuid())
  tenantId       String
  predictionType String // DEMAND, FINANCE, PROCUREMENT, OPERATIONS, SUPPLIER, INTEGRATION
  entityType     String? // Supplier, Customer, Product, etc.
  entityId       String?
  metric         String // e.g. 'invoice_volume', 'mismatch_risk'
  forecastPeriod String // DAILY, WEEKLY, MONTHLY
  forecastStart  DateTime
  forecastEnd    DateTime

  predictedValue  Float
  lowerBound      Float?
  upperBound      Float?
  confidenceLevel String // HIGH, MEDIUM, LOW

  modelType      String // e.g. 'baseline_moving_average', 'seasonal_baseline'
  modelVersion   String
  featureVersion String
  trainingWindow String

  status      String @default("ACTIVE") // ACTIVE, EVALUATED, INSUFFICIENT_DATA, SUPERSEDED
  actualValue Float?
  errorMetric Json?

  metadata    Json?
  generatedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, predictionType])
  @@index([tenantId, metric])
  @@index([tenantId, entityType, entityId])
}

model RiskSignal {
  id         String  @id @default(uuid())
  tenantId   String
  riskType   String // DEMAND_SPIKE, SUPPLIER_DELAY, CAPACITY_RISK, etc.
  severity   String // CRITICAL, HIGH, MEDIUM, LOW
  entityType String?
  entityId   String?

  title       String
  description String?
  evidence    Json?

  expectedImpact String?
  confidence     String
  status         String  @default("OPEN") // OPEN, ACKNOWLEDGED, MONITORING, MITIGATED, RESOLVED, DISMISSED

  recommendedActions Json?

  detectedAt DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, riskType])
  @@index([tenantId, severity])
}

// ==========================================
// 19. Manufacturing Planning & Decision Automation
// ==========================================

model PlanningRun {
  id                String   @id @default(uuid())
  tenantId          String
  planningRunNumber String   @unique
  planningType      String // DEMAND_PLANNING, MATERIAL_PLANNING, PROCUREMENT_PLANNING, CAPACITY_PLANNING, SCENARIO
  status            String   @default("DRAFT") // DRAFT, QUEUED, RUNNING, COMPLETED, PARTIAL, FAILED, CANCELLED
  startDate         DateTime
  endDate           DateTime

  createdBy   String
  startedAt   DateTime?
  completedAt DateTime?

  modelVersion         String?
  forecastVersion      String?
  configurationVersion String?

  summary  Json?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recommendations ProcurementRecommendation[]

  @@index([tenantId, status])
  @@index([tenantId, planningType])
}

model ProcurementRecommendation {
  id                 String    @id @default(uuid())
  tenantId           String
  planningRunId      String
  recommendationType String // MATERIAL_SHORTAGE, REORDER, CAPACITY_EXPANSION
  entityType         String? // Material, Supplier
