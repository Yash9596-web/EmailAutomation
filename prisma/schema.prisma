  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, category])
}

model PaymentReconciliation {
  id               String @id @default(uuid())
  tenantId         String
  reconciliationId String @unique

  paymentId         String?
  externalReference String?

  matchedInvoiceId String?
  matchConfidence  Decimal @default(0)

  status          String  @default("PENDING") // PENDING, MATCHED, EXCEPTION, RESOLVED
  resolutionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

model TaxConfiguration {
  id             String  @id @default(uuid())
  tenantId       String
  taxType        String  @unique // e.g. VAT, GST
  ratePercentage Decimal
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 25. Customer & Sales Automation (CRM)
// ==========================================

model Lead {
  id        String  @id @default(uuid())
  tenantId  String
  firstName String?
  lastName  String?
  company   String
  email     String?
  phone     String?

  source String?
  status String  @default("NEW") // NEW, CONTACTED, QUALIFIED, DISQUALIFIED

  ownerId String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

model Opportunity {
  id       String @id @default(uuid())
  tenantId String
  name     String

  customerId String?
  leadId     String?

  expectedValue Decimal @default(0)
  currency      String  @default("USD")

  expectedCloseDate DateTime?

  stage   String  @default("NEW") // NEW, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, stage])
  @@index([tenantId, expectedCloseDate])
}

model CustomerIssue {
  id           String @id @default(uuid())
  tenantId     String
  ticketNumber String @unique

  customerId   String
  salesOrderId String?
  invoiceId    String?
  shipmentId   String?

  category String
  priority String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status   String @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CUSTOMER, RESOLVED, CLOSED

  assignedUserId String?
  slaTarget      DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

// ==========================================
// 26. Advanced AI Agent Orchestration
// ==========================================

model AiAgentRun {
  id             String  @id @default(uuid())
  tenantId       String
  userId         String
  conversationId String?

  agentName       String // e.g., 'MANUFACTURING', 'PROCUREMENT', 'FINANCE'
  taskDescription String

  status String  @default("QUEUED") // QUEUED, RUNNING, WAITING_APPROVAL, COMPLETED, FAILED, CANCELLED
  result Json?
  error  String?

  totalTokens    Int @default(0)
  executionDepth Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  toolExecutions AiToolExecution[]

  @@index([tenantId, agentName])
  @@index([tenantId, status])
  @@index([tenantId, userId])
}

model AiToolExecution {
  id         String @id @default(uuid())
  tenantId   String
  agentRunId String

  toolName String
  category String // READ_ONLY, DRAFT, ACTION

  inputArgs    Json?
  outputResult Json?

  status          String @default("PENDING") // PENDING, SUCCESS, FAILED
  executionTimeMs Int    @default(0)

  error String?

  createdAt DateTime @default(now())

  agentRun AiAgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([tenantId, toolName])
  @@index([agentRunId])
}

model AiUsageLog {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  provider String @default("OPENAI")
  model    String

  promptTokens     Int
  completionTokens Int
  totalTokens      Int

  estimatedCost Decimal @default(0)

  context   String? // 'agent_run', 'chat_completion'
  contextId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
}

// ==========================================
// 27. Autonomous Business Operations
// ==========================================

model OperationalSituation {
  id       String @id @default(uuid())
  tenantId String

  title       String
  description String
  sourceType  String // e.g., PRODUCTION_ORDER, INVOICE, SHIPMENT
  sourceId    String

  severity String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status   String @default("DETECTED") // DETECTED, RECOMMENDED, APPROVED, EXECUTED, VERIFIED, FAILED, DISMISSED

  evidence Json?

  recommendedAction String?
  agentName         String? // Which agent made the recommendation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions AutonomousAction[]

  @@index([tenantId, status])
  @@index([tenantId, sourceType, sourceId])
}

model AutonomousPolicy {
  id       String @id @default(uuid())
  tenantId String
  name     String

  triggerType String // e.g., MATERIAL_SHORTAGE, SHIPMENT_DELAY
  conditions  Json // Rule-engine constraints

  allowedAction String
  riskLevel     String @default("LOW")

  executionMode    String  @default("OBSERVE") // OBSERVE, RECOMMEND, AUTONOMOUS
  requiresApproval Boolean @default(true)

  maxFrequencyMins Int @default(60) // Cooldown period

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, triggerType])
}

model AutonomousAction {
  id          String @id @default(uuid())
  tenantId    String
  situationId String

  actionType String
  payload    Json?

  status String @default("PENDING_APPROVAL") // PENDING_APPROVAL, QUEUED, EXECUTING, SUCCESS, FAILED

  policyId   String?
  approvedBy String?

  executionResult Json?
  errorReason     String?

  verificationStatus String @default("PENDING") // PENDING, VERIFIED, VERIFICATION_FAILED

  createdAt  DateTime  @default(now())
  executedAt DateTime?

  situation OperationalSituation @relation(fields: [situationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model TenantOperationsConfig {
  id       String @id @default(uuid())
  tenantId String @unique

  autonomousEnabled Boolean @default(false)
  emergencyPause    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 28. Enterprise Analytics & Intelligence
// ==========================================

model KpiDefinition {
  id       String @id @default(uuid())
  tenantId String

  name        String
  description String?
  category    String // OPERATIONS, FINANCE, SALES, INVENTORY, PROCUREMENT, LOGISTICS

  calculationRule Json // Defines how to aggregate transactional data
  unit            String // PERCENTAGE, CURRENCY, COUNT, DAYS

  targetValue   Decimal?
  thresholdLow  Decimal?
  thresholdHigh Decimal?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values KpiValue[]

  @@unique([tenantId, name])
  @@index([tenantId, category])
}

model KpiValue {
  id       String @id @default(uuid())
  tenantId String
  kpiId    String

  date  DateTime // Represents the day/week/month of the aggregated metric
  value Decimal

  historicalValue Decimal?
  trend           Decimal? // Percentage change

  metadata Json? // Optional drill-down parameters

  createdAt DateTime @default(now())

  kpi KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kpiId, date])
  @@index([tenantId, date])
}

model ScheduledReport {
  id       String @id @default(uuid())
  tenantId String

  name         String
  reportType   String // EXECUTIVE, OPERATIONS, SALES, FINANCE
  scheduleCron String

  recipients Json // Array of user IDs or emails
  format     String @default("PDF") // PDF, CSV, XLSX
  filters    Json?

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive])
}

// ==========================================
// 29. Advanced Enterprise Integrations
// ==========================================

model IntegrationFieldMapping {
  id            String @id @default(uuid())
  tenantId      String
  integrationId String

  entityType String // e.g., CUSTOMER, INVOICE, PRODUCT

  externalField String
  internalField String

  transformation String? // e.g., TO_UPPER, STRING_TO_DECIMAL, LOOKUP
  defaultValue   String?
  isRequired     Boolean @default(false)

  direction String @default("BIDIRECTIONAL") // INBOUND, OUTBOUND, BIDIRECTIONAL

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, entityType, externalField])
}

model IntegrationSyncConflict {
  id            String @id @default(uuid())
  tenantId      String
  syncJobId     String
  integrationId String

  entityType String
  internalId String?
  externalId String?

  conflictReason  String
  payloadSnapshot Json?

  resolutionStatus String  @default("PENDING") // PENDING, RESOLVED_INTERNAL, RESOLVED_EXTERNAL, IGNORED, MANUAL_REVIEW
  resolutionNotes  String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  syncJob IntegrationSyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([tenantId, integrationId, resolutionStatus])
}

// ==========================================
// 30. Enterprise Security & Compliance
// ==========================================

model SsoConfiguration {
  id       String @id @default(uuid())
  tenantId String @unique

  providerType String // SAML, OIDC
  providerName String

  metadataUrl String?
  entityId    String?
  ssoUrl      String?
  certificate String? // Public cert for signature verification

  clientId     String? // For OIDC
  clientSecret String? // Encrypted, for OIDC

  domain String? // Used for SP-initiated domain mapping

  isEnabled      Boolean @default(false)
  enforceSsoOnly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain])
}

model SecurityEvent {
  id       String  @id @default(uuid())
  tenantId String
  userId   String?

  eventType String // FAILED_LOGIN, SUSPICIOUS_ACTIVITY, PERMISSION_CHANGE, EXPORT_DOWNLOAD, API_ABUSE
  severity  String @default("INFO") // INFO, WARNING, CRITICAL

  ipAddress String?
  userAgent String?

  resourceType String?
  resourceId   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId, eventType])
  @@index([tenantId, severity])
  @@index([tenantId, createdAt])
}

model DataRetentionPolicy {
  id       String @id @default(uuid())
  tenantId String

  dataType      String // LOGS, AUDIT, DOCUMENTS, ANALYTICS
  retentionDays Int    @default(365)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dataType])
}

// ==========================================
// 31. Performance, Scalability & Quotas
