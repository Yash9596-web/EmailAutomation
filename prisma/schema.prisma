  evidence           Json?
  confidence         String // HIGH, MEDIUM, LOW
  status             String    @default("PROPOSED") // PROPOSED, UNDER_REVIEW, APPROVED, REJECTED, EXECUTED, EXPIRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

