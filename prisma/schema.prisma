  tenantId  String
  rfqNumber String @unique
  title     String
  status    String @default("DRAFT") // DRAFT, SENT, PARTIALLY_RESPONDED, RESPONDED, EVALUATING, AWARDED, CANCELLED, EXPIRED

  deadline DateTime?
  notes    String?

  quotations SupplierQuotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

