model SubscriptionPlan {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  priceMonthly Decimal @default(0)
  priceAnnual  Decimal @default(0)
  currency     String  @default("USD")

  trialDays Int     @default(14)
  isActive  Boolean @default(true)

  features FeatureEntitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureEntitlement {
  id     String @id @default(uuid())
  planId String

  featureKey  String // e.g., 'MAX_USERS', 'WORKFLOW_AUTOMATION', 'AI_AGENTS'
  limitAmount Int? // null means unlimited
  isEnabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique
  planId   String

  status String @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELLED, SUSPENDED

  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd Boolean @default(false)

  billingCustomerId     String? // Stripe/Chargebee ID
  billingSubscriptionId String? // Stripe/Chargebee ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantUsageRecord {
  id       String @id @default(uuid())
  tenantId String

  featureKey   String
  quantityUsed Int    @default(0)

  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, featureKey, periodStart, periodEnd])
}

model TenantApiKey {
  id       String @id @default(uuid())
  tenantId String

  name    String
  keyHash String @unique // Bcrypt/Argon2 hash of the API key

  scopes String[] // read:orders, write:inventory

  expiresAt  DateTime?
  lastUsedAt DateTime?

  isRevoked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isRevoked])
}

model TenantInvitation {
  id       String @id @default(uuid())
  tenantId String

  email        String
  role         String  @default("MEMBER")
  departmentId String?

  token     String   @unique
  expiresAt DateTime

  status String @default("PENDING") // PENDING, ACCEPTED, CANCELLED, EXPIRED

  invitedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, email, status])
}

// ==========================================
// 33. Mobile & Field Operations
// ==========================================

model FieldTask {
  id       String @id @default(uuid())
  tenantId String

  taskNumber  String  @unique
  title       String
  description String?

  taskType String // INSPECTION, MAINTENANCE, DELIVERY, QUALITY_CHECK
  priority String @default("MEDIUM")

  status String @default("ASSIGNED") // ASSIGNED, ACCEPTED, IN_PROGRESS, ON_HOLD, COMPLETED, FAILED, CANCELLED

  assignedUserId String?
  locationRef    String? // Could be WarehouseId, GPS coords, or Customer address
  dueDate        DateTime?

  relatedEntityId   String? // Generic ID linking to Shipment, ProductionOrder, etc.
  relatedEntityType String?

  completionNotes String?
  evidenceJson    Json? // Array of Document/Image IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, assignedUserId, status])
}

model OfflineSyncQueue {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  idempotencyKey String @unique
  operationType  String // e.g., UPDATE_TASK, RECORD_CONSUMPTION
  payload        Json

  status      String  @default("PENDING") // PENDING, SYNCED, CONFLICT, FAILED
  errorReason String?

  createdAt DateTime  @default(now())
  syncedAt  DateTime?

  @@index([tenantId, userId, status])
}

// ==========================================
// 34. Commercialization & Support
// ==========================================

model CustomerSupportTicket {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  subject     String
  description String
  category    String @default("GENERAL") // GENERAL, BILLING, TECHNICAL, FEATURE_REQUEST
  priority    String @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT

  status String @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CUSTOMER, RESOLVED, CLOSED

  assignedAdminId String?
  internalNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([status, priority])
}

model CustomerFeedback {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  category String // FEATURE_REQUEST, BUG_REPORT, GENERAL
  rating   Int? // 1-5 scale
  comment  String

  status String @default("NEW") // NEW, REVIEWED, PLANNED, IMPLEMENTED, DECLINED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, category])
}
