model TenantResourceQuota {
  id       String @id @default(uuid())
  tenantId String

  resourceType String // e.g., API_REQUESTS, AI_TOKENS, BACKGROUND_JOBS, EXPORTS

  limitAmount  BigInt
  periodWindow String @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, ANNUAL

  currentUsage BigInt @default(0)

  alertThresholdPercent Decimal @default(80)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, resourceType, periodWindow])
}

model SystemHealthMetric {
  id     String @id @default(uuid())
  nodeId String // Worker ID or API Node

  metricType  String // CPU, MEMORY, QUEUE_DEPTH, DB_LATENCY
  metricValue Decimal

  recordedAt DateTime @default(now())

  @@index([metricType, recordedAt])
}

model RateLimitEvent {
